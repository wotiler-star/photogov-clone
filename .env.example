# Copy to `.env` and adjust as needed.
# The app currently reads no required runtime variables — these are optional hooks
# for future use (e.g. analytics, a real contact-form backend, or CDN config).

# Public site URL (used by some SEO/OG generators if you prefer a fixed origin)
NUXT_PUBLIC_SITE_URL=https://your-domain.example

# ---- SMTP (required for account activation in production) ----
# With SMTP_HOST set, verification / password-reset emails are really sent and
# the email-verification gate (checkout / subscription) is ENFORCED.
# Without SMTP_HOST, sendMail() only logs to the server console. In production
# builds EMAIL_DEBUG is false, so NO dev link is returned and users could never
# activate: in that state the gate automatically fails open and the UI shows an
# "email delivery unavailable" notice instead of a misleading "email sent".
# => Fill in SMTP_* and MAIL_FROM before going live (e.g. on Hostinger).
# Leave the values empty locally unless you have a real SMTP account.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Local demo only: forces verification/reset links into API responses even in
# production builds. NEVER enable on a public site (links contain tokens).
# Setting EMAIL_DEBUG=1 also enables the verification gate without SMTP.
EMAIL_DEBUG=0

# Secret used to sign member session cookies (CHANGE THIS in production)
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Payments (optional) ----
# Leave Stripe values empty to run the built-in Demo gateway (/payment/simulate):
# the whole checkout -> callback -> fulfillment flow runs locally for testing.
# Set PAYMENT_DEMO_MODE=1 to force Demo mode even when Stripe keys are present.

# Stripe secret key (server-side only — never expose to the client)
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe webhook signing secret for endpoint:
#   POST https://your-domain/api/app/v1/subscription/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Force the Demo gateway even when Stripe keys are configured (local testing)
PAYMENT_DEMO_MODE=0
# Shared secret used to sign Demo-gateway callbacks (change in production)
PAYMENT_DEMO_TOKEN=change-me-to-a-long-random-string

