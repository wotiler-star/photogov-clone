# Copy to `.env` and adjust as needed.
# The app currently reads no required runtime variables — these are optional hooks
# for future use (e.g. analytics, a real contact-form backend, or CDN config).

# Public site URL (used by some SEO/OG generators if you prefer a fixed origin)
NUXT_PUBLIC_SITE_URL=https://your-domain.example

# ---- SMTP (optional) ----
# When set, verification & password-reset emails are sent for real.
# When unset, emails are printed to the server console (dev mode) and a dev
# verification/reset link is returned to the client for local testing.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password
MAIL_FROM=no-reply@your-domain.example

# Force dev email links even when SMTP is configured (handy for local testing)
EMAIL_DEBUG=1

# Secret used to sign member session cookies (CHANGE THIS in production)
SESSION_SECRET=change-me-to-a-long-random-string
